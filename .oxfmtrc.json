{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"sortImports": {
		"newlinesBetween": false,
		"customGroups": [
			{
				"groupName": "types",
				"selector": "type"
			}
		],
		"groups": ["builtin", "external", ["parent", "sibling", "index"], "types", "unknown"]
	},
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 100,
	"semi": true,
	"singleQuote": false,
	"sortPackageJson": true,
	"ignorePatterns": ["pnpm-lock.yaml", "pnpm-workspace.yaml"]
}
